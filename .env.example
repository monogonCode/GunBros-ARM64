# ==============================================================================
# GunBros ARM64 Bridge - Configuración de Entorno
# ==============================================================================
# Copia este archivo a .env y ajusta las rutas según tu sistema:
#   cp .env.example .env
#
# Las rutas relativas (que empiezan con ./) se resolverán automáticamente
# respecto a la raíz del repositorio.
# ==============================================================================

# 1. Android NDK (Requerido para compilación cruzada ARM64)
# Ruta al NDK r23c a r26d (debe contener build/cmake/android.toolchain.cmake)
# Ejemplo con NDK local en el repo:
ANDROID_NDK_HOME="./tools/android-ndk-r26d"
# Ejemplo con NDK de Android Studio / SDK estándar:
# ANDROID_NDK_HOME="$HOME/Android/Sdk/ndk/26.1.10909125"
NDK="$ANDROID_NDK_HOME"

# 2. Android SDK y Build Tools (Requerido para zipalign y apksigner)
# Ruta a la carpeta que contiene build-tools (con zipalign y apksigner)
# Ejemplo con herramientas locales en el repo:
BUILD_TOOLS="./tools/build-tools/34.0.0"
# Ejemplo con Android SDK estándar:
# ANDROID_HOME="$HOME/Android/Sdk"
# BUILD_TOOLS="$ANDROID_HOME/build-tools/34.0.0"

# 3. Herramientas de Compilación (CMake y CTest)
# Si cmake y ctest están en el PATH de tu sistema, puedes usar simplemente "cmake" y "ctest".
# Ejemplo usando cmake del sistema:
CMAKE_BIN="cmake"
CTEST_BIN="ctest"
# Ejemplo usando cmake empaquetado en tools/:
# CMAKE_BIN="./tools/cmake/bin/cmake"
# CTEST_BIN="./tools/cmake/bin/ctest"

# 4. Dependencias de Emulación (Dynarmic y Boost)
# Por defecto se encuentran en la carpeta third_party/ del repositorio.
DYNARMIC_ROOT="./third_party/dynarmic"
BOOST_ROOT="./third_party/boost/usr/include"

# 5. Keystore de Depuración para firma del APK
KEYSTORE="./third_party/keystore/debug.keystore"
KEYSTORE_PASS="pass:android"

# 6. Parámetros de Despliegue con ADB
# Si tienes múltiples dispositivos conectados por USB, especifica el número de serie aquí:
# ADB_SERIAL="TU_SERIAL_DISPOSITIVO"
# Flags de instalación requeridos en Android 14, 15 y 16:
ADB_INSTALL_FLAGS="--no-incremental --bypass-low-target-sdk-block -r -d"
